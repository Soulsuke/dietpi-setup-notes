### Ruby on Rails
###############################################################################

# We definitely do not need the bundle:
**/vendor/bundle/

# Same for the tmp folder:
**/rails/*/tmp/

# Also... Skip the credentials.
**/rails/*/config/*.key
**/rails/*/config/credentials/*.ke

# Same for gems/ruby versions installed on a per-user basis:
/home/rails/*/.bundle
/home/rails/*/.cache
/home/rails/*/.passenger
/home/rails/*/.rbenv

