### General
###############################################################################

# Do not backup vim plugins, most are submodules anyways:
**/pack/plugins

# And it's better to also exclude the downloads folder:
**/dietpi_userdata/Downloads



### Jellyfin
###############################################################################

# Let's not backup the media folder:
**/dietpi_userdata/jellyfin_media

# Nor the metadata folder:
**/dietpi_userdata/jellyfin/metadata

# Nor the cache:
**/dietpi_userdata/jellyfin/cache



### Pi-Hole
###############################################################################

# Let's ignore the whole folder, as we'll use teleporter for its backup:
/etc/pihole



### Ruby on Rails
###############################################################################

# We definitely do not need the bundle:
**/vendor/bundle

# Same for the tmp folder:
**/rails/*/tmp

# Also... Skip the credentials.
**/rails/*/config/*.key
**/rails/*/config/credentials/*.key

# Same for gems/ruby versions installed on a per-user basis:
/home/rails/*/.bundle
/home/rails/*/.cache
/home/rails/*/.passenger
/home/rails/*/.rbenv

